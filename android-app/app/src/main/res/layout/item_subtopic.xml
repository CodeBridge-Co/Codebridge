<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_card_outline"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <!-- Subtopic Tile Icon -->
    <LinearLayout
        android:id="@+id/tileContainer"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_tile"
        android:backgroundTint="@color/cb_cat_sky"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/ivIcon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_cb_code"
            app:tint="@color/cb_ink" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvSubtopicName"
            style="@style/CbText.Strong"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Arrays"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvCount"
            style="@style/CbText.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="0 / 2"
            android:textColor="@color/cb_text_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvPercent"
        style="@style/CbText.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:text="0%"
        android:textColor="@color/cb_text_secondary"
        android:textSize="11sp" />

    <ImageView
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_cb_up"
        android:rotation="90"
        app:tint="@color/cb_text_secondary" />
</LinearLayout>
