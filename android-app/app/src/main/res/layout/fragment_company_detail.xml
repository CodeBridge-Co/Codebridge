<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cb_bg"
    android:orientation="vertical">

    <!-- Top Dark Header Banner -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_dark_card"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="20dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:src="@drawable/ic_cb_back"
            app:tint="@color/cb_bg" />

        <TextView
            android:id="@+id/tvHeaderLogo"
            style="@style/CbText.Hero"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/nunito_extrabold"
            android:text="amazon"
            android:textColor="@color/cb_bg"
            android:textSize="26sp" />
    </LinearLayout>

    <!-- Main Content Sheet -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/tvCompanyTitle"
            style="@style/CbText.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Amazon Challenges"
            android:textSize="18sp" />

        <TextView
            style="@style/CbText.Strong"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="About Company"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvCompanyAbout"
            style="@style/CbText.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Solve real-world problems used by Amazon engineers. Build your skills and get noticed!"
            android:textSize="12sp" />

        <!-- Sub Tabs: Challenges | Leaderboard -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_chip"
            android:orientation="horizontal"
            android:padding="2dp">

            <TextView
                android:id="@+id/tabChallenges"
                style="@style/CbText.Strong"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_chip_selected"
                android:gravity="center"
                android:text="Challenges"
                android:textColor="@color/cb_bg"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tabLeaderboard"
                style="@style/CbText.Strong"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Leaderboard"
                android:textColor="@color/cb_ink"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Difficulty Filter Chips -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:clipToPadding="false"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipAll"
                    style="@style/CbText.Strong"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_chip_selected"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="All"
                    android:textColor="@color/cb_bg"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/chipEasy"
                    style="@style/CbText.Strong"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_chip"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="Easy"
                    android:textColor="@color/cb_ink"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/chipMedium"
                    style="@style/CbText.Strong"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_chip"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="Medium"
                    android:textColor="@color/cb_ink"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/chipHard"
                    style="@style/CbText.Strong"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="Hard"
                    android:textColor="@color/cb_ink"
                    android:textSize="11sp" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Company Specific Challenges List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvCompanyChallenges"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="8dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
    </LinearLayout>
</LinearLayout>
