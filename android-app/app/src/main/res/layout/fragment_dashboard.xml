<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cb_bg"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <!-- Top bar -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="40dp">

            <TextView
                style="@style/CbText.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|center_vertical"
                android:text="codebridge."
                android:textSize="18sp" />

            <TextView
                android:id="@+id/tvAvatar"
                style="@style/CbText.Caption"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="end|center_vertical"
                android:background="@drawable/bg_circle_black"
                android:fontFamily="@font/nunito_extrabold"
                android:gravity="center"
                android:text="CG"
                android:textColor="@color/cb_bg"
                android:textSize="12sp" />
        </FrameLayout>

        <!-- Greeting -->
        <TextView
            android:id="@+id/tvGreeting"
            style="@style/CbText.Hero"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Good afternoon, Cody Grace."
            android:textSize="20sp" />

        <TextView
            style="@style/CbText.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="What will you build today?"
            android:textSize="13sp" />

        <!-- Search Bar -->
        <EditText
            android:id="@+id/etSearch"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:drawableStart="@drawable/ic_cb_search"
            android:drawablePadding="10dp"
            android:drawableTint="@color/cb_text_secondary"
            android:fontFamily="@font/nunito_regular"
            android:hint="Search challenges, events, skills…"
            android:imeOptions="actionSearch"
            android:importantForAutofill="no"
            android:inputType="text"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textSize="13sp" />

        <!-- Daily Challenge Banner -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_dark_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/CbText.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:drawableStartCompat="@drawable/dot_green"
                    android:drawablePadding="6dp"
                    android:text="DAILY CHALLENGE"
                    android:textColor="@color/cb_green"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/tvDailyTitle"
                    style="@style/CbText.Hero"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Two Sum"
                    android:textColor="@color/cb_bg"
                    android:textSize="20sp" />

                <TextView
                    style="@style/CbText.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Java · Easy · 15 min"
                    android:textColor="#B5B5B5"
                    android:textSize="11sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginEnd="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progressDaily"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:indeterminate="false"
                        android:progress="68"
                        app:indicatorColor="@color/cb_green"
                        app:trackColor="@color/cb_white_20"
                        app:trackCornerRadius="3dp"
                        app:trackThickness="5dp" />

                    <TextView
                        style="@style/CbText.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="68%"
                        android:textColor="#B5B5B5"
                        android:textSize="10sp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnContinue"
                    style="@style/CbButton.White"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:paddingHorizontal="16dp"
                    android:text="Continue challenge →"
                    android:textSize="12sp"
                    app:cornerRadius="24dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="88dp"
                android:layout_height="90dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_code_panel"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    style="@style/CbText.Mono"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="[ 2, 7, 11 ]"
                    android:textColor="@color/cb_green"
                    android:textSize="10sp" />

                <TextView
                    style="@style/CbText.Mono"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="target = 9"
                    android:textColor="@color/cb_bg"
                    android:textSize="10sp" />

                <TextView
                    style="@style/CbText.Mono"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="return [0,1]"
                    android:textColor="@color/cb_bg"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- What's on CodeBridge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/CbText.Section"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="What's on CodeBridge"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/linkExploreAll"
                style="@style/CbText.Link"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Explore all →"
                android:textSize="11sp" />
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="132dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_card"
                    android:backgroundTint="@color/cb_cat_lilac"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_tile"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_cb_code"
                            app:tint="@color/cb_ink" />
                    </LinearLayout>

                    <TextView
                        style="@style/CbText.Strong"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Technical Challenges"
                        android:textSize="12sp" />

                    <TextView
                        style="@style/CbText.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="52 problems"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/link0"
                        style="@style/CbText.Strong"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Start coding"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="132dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_card"
                    android:backgroundTint="@color/cb_cat_peach"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_tile"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_cb_branch"
                            app:tint="@color/cb_ink" />
                    </LinearLayout>

                    <TextView
                        style="@style/CbText.Strong"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Company Challenges"
                        android:textSize="12sp" />

                    <TextView
                        style="@style/CbText.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Real briefs"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/link1"
                        style="@style/CbText.Strong"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="View briefs"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="132dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card"
                    android:backgroundTint="@color/cb_cat_sky"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_tile"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_cb_cal"
                            app:tint="@color/cb_ink" />
                    </LinearLayout>

                    <TextView
                        style="@style/CbText.Strong"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Events &amp; Hackathons"
                        android:textSize="12sp" />

                    <TextView
                        style="@style/CbText.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Meet &amp; compete"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/link2"
                        style="@style/CbText.Strong"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="See events"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Upcoming events -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/CbText.Section"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Upcoming events"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/linkViewAllEvents"
                style="@style/CbText.Link"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="View all events →"
                android:textSize="11sp" />
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="128dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_card_outline"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="70dp"
                        android:background="@drawable/bg_tile"
                        android:backgroundTint="@color/cb_tile_lime">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_margin="10dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_cb_code"
                            app:tint="@color/cb_ink" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom|end"
                            android:layout_margin="8dp"
                            android:alpha="0.55"
                            android:fontFamily="@font/nunito_extrabold"
                            android:text="CB"
                            android:textColor="@color/cb_ink"
                            android:textSize="16sp" />
                    </FrameLayout>

                    <TextView
                        style="@style/CbText.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="OCT 28"
                        android:textSize="10sp" />

                    <TextView
                        style="@style/CbText.Strong"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:maxLines="2"
                        android:text="Developer Hackathon 2026"
                        android:textSize="11sp" />

                    <TextView
                        style="@style/CbText.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Hackathon"
                        android:textColor="@color/cb_green_dark"
                        android:textSize="10sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="128dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_card_outline"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="70dp"
                        android:background="@drawable/bg_tile"
                        android:backgroundTint="@color/cb_tile_sky">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_margin="10dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_cb_code"
                            app:tint="@color/cb_ink" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom|end"
                            android:layout_margin="8dp"
                            android:alpha="0.55"
                            android:fontFamily="@font/nunito_extrabold"
                            android:text="CB"
                            android:textColor="@color/cb_ink"
                            android:textSize="16sp" />
                    </FrameLayout>

                    <TextView
                        style="@style/CbText.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="NOV 06"
                        android:textSize="10sp" />

                    <TextView
                        style="@style/CbText.Strong"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:maxLines="2"
                        android:text="Tech Talk: AI Enterprise"
                        android:textSize="11sp" />

                    <TextView
                        style="@style/CbText.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Tech talk"
                        android:textColor="@color/cb_green_dark"
                        android:textSize="10sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="128dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_card_outline"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="70dp"
                        android:background="@drawable/bg_tile"
                        android:backgroundTint="@color/cb_tile_peach">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_margin="10dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_cb_code"
                            app:tint="@color/cb_ink" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom|end"
                            android:layout_margin="8dp"
                            android:alpha="0.55"
                            android:fontFamily="@font/nunito_extrabold"
                            android:text="CB"
                            android:textColor="@color/cb_ink"
                            android:textSize="16sp" />
                    </FrameLayout>

                    <TextView
                        style="@style/CbText.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="NOV 12"
                        android:textSize="10sp" />

                    <TextView
                        style="@style/CbText.Strong"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:maxLines="2"
                        android:text="Better Together"
                        android:textSize="11sp" />

                    <TextView
                        style="@style/CbText.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Workshop"
                        android:textColor="@color/cb_green_dark"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
