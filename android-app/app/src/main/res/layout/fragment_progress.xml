<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cb_bg"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <!-- Top Header -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="36dp">

            <TextView
                style="@style/CbText.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|center_vertical"
                android:text="Progress &amp; History"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/tvSummary"
                style="@style/CbText.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|center_vertical"
                android:text="24 Solved · 87% Avg"
                android:textColor="@color/cb_green_dark" />
        </FrameLayout>

        <!-- Category Tabs / Filter -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_chip"
            android:orientation="horizontal"
            android:padding="2dp">

            <TextView
                android:id="@+id/tabAll"
                style="@style/CbText.Strong"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_chip_selected"
                android:gravity="center"
                android:text="All Activity"
                android:textColor="@color/cb_bg"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tabInProgress"
                style="@style/CbText.Strong"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="In Progress"
                android:textColor="@color/cb_ink"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tabCompleted"
                style="@style/CbText.Strong"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Completed"
                android:textColor="@color/cb_ink"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- SECTION: In Progress Challenges -->
        <TextView
            style="@style/CbText.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="In Progress (Started / Unfinished)"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card_outline"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/CbText.Strong"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1. Two Sum"
                        android:textSize="13sp" />

                    <TextView
                        style="@style/CbText.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Stage 1 completed · 68% progress"
                        android:textSize="10sp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnResume1"
                    style="@style/CbButton.Green.Small"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="Resume →"
                    android:textSize="10sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="10dp"
                android:background="@color/cb_line" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/CbText.Strong"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3. Longest Substring"
                        android:textSize="13sp" />

                    <TextView
                        style="@style/CbText.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Draft saved · 40% progress"
                        android:textSize="10sp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnResume2"
                    style="@style/CbButton.Green.Small"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="Resume →"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- SECTION: Completed Challenges -->
        <TextView
            style="@style/CbText.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Completed Challenges"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_cb_check"
                    app:tint="@color/cb_green_dark" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/CbText.Strong"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="5. Valid Anagram"
                        android:textSize="12sp" />

                    <TextView
                        style="@style/CbText.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cleared on 1st try · Score: 94%"
                        android:textSize="10sp" />
                </LinearLayout>

                <TextView
                    style="@style/CbText.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_tag_dark"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="3dp"
                    android:text="Easy"
                    android:textColor="@color/cb_green"
                    android:textSize="9sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="8dp"
                android:background="@color/cb_line" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_cb_check"
                    app:tint="@color/cb_green_dark" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/CbText.Strong"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="8. Reverse Linked List"
                        android:textSize="12sp" />

                    <TextView
                        style="@style/CbText.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cleared · Score: 88%"
                        android:textSize="10sp" />
                </LinearLayout>

                <TextView
                    style="@style/CbText.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_tag_dark"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="3dp"
                    android:text="Easy"
                    android:textColor="@color/cb_green"
                    android:textSize="9sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- SECTION: Improvement Tips & AI Insights -->
        <TextView
            style="@style/CbText.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="AI Improvement Tips"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_ai_hint"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_cb_spark"
                    app:tint="@color/cb_green_dark" />

                <TextView
                    style="@style/CbText.Strong"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Tip: Hash Map Trade-offs"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                style="@style/CbText.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="In Array challenges, always explain why trading O(N) space for O(N) time using Hash Maps is optimal for technical interviews."
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
