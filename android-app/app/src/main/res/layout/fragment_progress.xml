<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cb_bg"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <!-- Top Header -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="36dp">

            <TextView
                style="@style/CbText.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|center_vertical"
                android:text="Progress &amp; History"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/tvSummary"
                style="@style/CbText.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|center_vertical"
                android:text="0 Solved · 0% Avg"
                android:textColor="@color/cb_green_dark" />
        </FrameLayout>

        <!-- Category Tabs / Filter -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_chip"
            android:orientation="horizontal"
            android:padding="2dp">

            <TextView
                android:id="@+id/tabAll"
                style="@style/CbText.Strong"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_chip_selected"
                android:gravity="center"
                android:text="All Activity"
                android:textColor="@color/cb_bg"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tabInProgress"
                style="@style/CbText.Strong"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="In Progress"
                android:textColor="@color/cb_ink"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tabCompleted"
                style="@style/CbText.Strong"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Completed"
                android:textColor="@color/cb_ink"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- SECTION: In Progress Challenges -->
        <TextView
            android:id="@+id/tvInProgressTitle"
            style="@style/CbText.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="In Progress (Started / Unfinished)"
            android:textSize="13sp" />

        <!-- DYNAMIC CONTAINER FOR IN PROGRESS -->
        <LinearLayout
            android:id="@+id/llInProgressContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <!-- SECTION: Completed Challenges -->
        <TextView
            android:id="@+id/tvCompletedTitle"
            style="@style/CbText.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Completed Challenges"
            android:textSize="13sp" />

        <!-- DYNAMIC CONTAINER FOR COMPLETED -->
        <LinearLayout
            android:id="@+id/llCompletedContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <!-- SECTION: Improvement Tips & AI Insights -->
        <TextView
            style="@style/CbText.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="AI Improvement Tips"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_ai_hint"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_cb_spark"
                    app:tint="@color/cb_green_dark" />

                <TextView
                    android:id="@+id/tvAiTipTitle"
                    style="@style/CbText.Strong"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Analyzing Profile..."
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvAiTipBody"
                style="@style/CbText.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Complete a challenge to receive personalized AI insights."
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
