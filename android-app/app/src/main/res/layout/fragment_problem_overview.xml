<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cb_bg"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <!-- Header -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="36dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back"
                android:src="@drawable/ic_cb_back" />

            <TextView
                android:id="@+id/tvTitle"
                style="@style/CbText.Hero"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="40dp"
                android:text="Two Sum"
                android:textSize="22sp" />
        </FrameLayout>

        <!-- Category & Difficulty Chips -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvCategoryChip"
                style="@style/CbText.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tag_dark"
                android:backgroundTint="@color/cb_cat_sky"
                android:paddingHorizontal="12dp"
                android:paddingVertical="5dp"
                android:text="Arrays"
                android:textColor="@color/cb_ink"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvDifficultyChip"
                style="@style/CbText.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_tag_dark"
                android:backgroundTint="@color/cb_green_tint"
                android:paddingHorizontal="12dp"
                android:paddingVertical="5dp"
                android:text="Easy"
                android:textColor="@color/cb_green_dark"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Problem Description -->
        <TextView
            android:id="@+id/tvDescription"
            style="@style/CbText.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:lineSpacingMultiplier="1.2"
            android:text="Given an array of integers nums and an integer target, return indices of the two numbers such that they add up to target."
            android:textColor="@color/cb_ink"
            android:textSize="13sp" />

        <!-- Example 1 Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                style="@style/CbText.Strong"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Example 1:"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvEx1Input"
                style="@style/CbText.Mono"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Input: nums = [2,7,11,15], target = 9"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvEx1Output"
                style="@style/CbText.Mono"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Output: [0,1]"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Example 2 Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                style="@style/CbText.Strong"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Example 2:"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvEx2Input"
                style="@style/CbText.Mono"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Input: nums = [3,2,4], target = 6"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvEx2Output"
                style="@style/CbText.Mono"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Output: [1,2]"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Start Challenge Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStartChallenge"
            style="@style/CbButton.Green"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="24dp"
            android:text="Start Challenge"
            android:textSize="15sp"
            app:cornerRadius="25dp" />

        <!-- Test cases expandable header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/CbText.Strong"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Test Cases ∨"
                android:textColor="@color/cb_text_secondary"
                android:textSize="12sp" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_cb_lock"
                app:tint="@color/cb_text_secondary" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
