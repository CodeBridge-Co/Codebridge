<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_card_outline"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <!-- Company Tile / Logo -->
    <LinearLayout
        android:id="@+id/companyTile"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_tile"
        android:backgroundTint="@color/cb_tile_lime"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvLogoText"
            style="@style/CbText.Strong"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/nunito_extrabold"
            android:text="AMZ"
            android:textColor="@color/cb_ink"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvCompanyName"
            style="@style/CbText.Strong"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Amazon"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvCompanyTags"
            style="@style/CbText.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Frontend · Backend · System Design"
            android:textColor="@color/cb_text_secondary"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvChallengeCount"
            style="@style/CbText.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="12 challenges"
            android:textColor="@color/cb_green_dark"
            android:textSize="10sp" />
    </LinearLayout>

    <ImageView
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginStart="8dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_cb_up"
        android:rotation="90"
        app:tint="@color/cb_text_secondary" />
</LinearLayout>
