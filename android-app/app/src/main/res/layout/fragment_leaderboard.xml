<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cb_bg"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <!-- Header -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="36dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:src="@drawable/ic_cb_back" />

        <TextView
            style="@style/CbText.Hero"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="40dp"
            android:text="Leaderboard"
            android:textSize="18sp" />

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="end|center_vertical"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_cb_spark"
            app:tint="@color/cb_green_dark" />
    </FrameLayout>

    <!-- Sub Navigation Tabs: Global | My Rank | Friends -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_card"
        android:padding="3dp">

        <TextView
            android:id="@+id/tabGlobal"
            style="@style/CbText.Strong"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_chip_selected"
            android:gravity="center"
            android:text="Global"
            android:textColor="@color/cb_bg"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tabMyRank"
            style="@style/CbText.Strong"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="My Rank"
            android:textColor="@color/cb_ink"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tabFriends"
            style="@style/CbText.Strong"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Friends"
            android:textColor="@color/cb_ink"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Search Hash ID Input Field -->
    <EditText
        android:id="@+id/etSearchHash"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_card"
        android:drawableStart="@drawable/ic_cb_search"
        android:drawablePadding="8dp"
        android:drawableTint="@color/cb_text_secondary"
        android:fontFamily="monospace"
        android:hint="Search Hash ID…"
        android:imeOptions="actionSearch"
        android:importantForAutofill="no"
        android:inputType="text"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textSize="12sp" />

    <!-- Period Filter Chips -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chipAll"
                style="@style/CbText.Strong"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_chip_selected"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="All"
                android:textColor="@color/cb_bg"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/chip6M"
                style="@style/CbText.Strong"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_chip"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="6 Months"
                android:textColor="@color/cb_ink"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/chipMonth"
                style="@style/CbText.Strong"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_chip"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="This Month"
                android:textColor="@color/cb_ink"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/chipToday"
                style="@style/CbText.Strong"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="Today"
                android:textColor="@color/cb_ink"
                android:textSize="11sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Leaderboard RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvLeaderboard"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="8dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
</LinearLayout>
