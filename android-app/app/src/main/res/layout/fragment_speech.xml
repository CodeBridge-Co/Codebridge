<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/cb_bg" android:fillViewport="true" android:overScrollMode="never">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="20dp" android:paddingTop="12dp" android:paddingEnd="20dp" android:paddingBottom="28dp">
        <ImageButton android:id="@+id/btnBack" android:layout_width="40dp" android:layout_height="40dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Back" android:src="@drawable/ic_cb_back"/>
        <za.co.eduvos.codebridge.ui.StepperView android:id="@+id/stepper" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="18dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" style="@style/CbText.Label" android:text="Stage 3" android:layout_weight="1"/>
            <TextView android:id="@+id/tvAttempts" android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/CbText.Caption" android:text="3 attempts left" android:textColor="@color/cb_green_dark" android:fontFamily="@font/nunito_bold"/>
        </LinearLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/CbText.Hero" android:text="Verbal explanation" android:layout_marginTop="4dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/CbText.Body" android:text="Explain your approach and reasoning out loud." android:layout_marginTop="4dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_dark_card" android:padding="18dp" android:layout_marginTop="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:id="@+id/tvQuestionNo" android:layout_width="0dp" android:layout_height="wrap_content" style="@style/CbText.Caption" android:text="QUESTION 1 OF 3" android:layout_weight="1" android:textColor="#B5B5B5" android:letterSpacing="0.06"/>
                <TextView android:id="@+id/tvTimerTop" android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/CbText.Caption" android:text="00:00" android:drawableStart="@drawable/dot_green" android:drawablePadding="6dp" android:drawableTint="@color/cb_red" android:textColor="@color/cb_bg" android:fontFamily="monospace"/>
            </LinearLayout>
            <TextView android:id="@+id/tvQuestion" android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/CbText.Section" android:text="Explain your overall approach" android:layout_marginTop="12dp" android:textColor="@color/cb_bg"/>
            <za.co.eduvos.codebridge.ui.WaveformView android:id="@+id/waveform" android:layout_width="match_parent" android:layout_height="84dp" android:layout_marginTop="18dp"/>
            <TextView android:id="@+id/tvTimer" android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/CbText.Section" android:text="00:00" android:layout_gravity="center_horizontal" android:layout_marginTop="6dp" android:fontFamily="monospace" android:textColor="@color/cb_bg" android:textSize="20sp"/>
            <TextView android:id="@+id/tvRecState" android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/CbText.Label" android:text="RECORDING" android:layout_gravity="center_horizontal" android:layout_marginTop="4dp" android:textColor="@color/cb_green" android:textSize="10sp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center" android:layout_marginTop="14dp">
                <LinearLayout android:layout_width="64dp" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal" android:layout_marginEnd="36dp">
                    <ImageButton android:id="@+id/btnPause" android:layout_width="44dp" android:layout_height="44dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Pause" android:src="@drawable/ic_cb_pause" app:tint="@color/cb_bg"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/CbText.Caption" android:text="Pause" android:textColor="#B5B5B5" android:textSize="10sp"/>
                </LinearLayout>
                <FrameLayout android:layout_width="76dp" android:layout_height="76dp" android:background="@drawable/bg_circle_black" android:backgroundTint="#3A1F1F">
                    <com.google.android.material.floatingactionbutton.FloatingActionButton android:id="@+id/btnRecord" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:contentDescription="Record" android:src="@drawable/ic_cb_mic" app:backgroundTint="@color/cb_red" app:tint="@color/cb_bg" app:elevation="0dp"/>
                </FrameLayout>
                <LinearLayout android:layout_width="64dp" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal" android:layout_marginStart="36dp">
                    <ImageButton android:id="@+id/btnDiscard" android:layout_width="44dp" android:layout_height="44dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Discard" android:src="@drawable/ic_cb_trash" app:tint="@color/cb_bg"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/CbText.Caption" android:text="Discard" android:textColor="#B5B5B5" android:textSize="10sp"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card" android:padding="14dp" android:layout_marginTop="14dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" style="@style/CbText.Label" android:text="LIVE TRANSCRIPT" android:layout_weight="1" android:textColor="@color/cb_ink" android:textSize="10sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/CbText.Caption" android:text="Live" android:drawableStart="@drawable/dot_green" android:drawablePadding="6dp" android:textColor="@color/cb_green_dark"/>
            </LinearLayout>
            <TextView android:id="@+id/tvTranscript" android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/CbText.Body" android:text="Start recording to see your words appear here." android:layout_marginTop="8dp" android:lineSpacingMultiplier="1.2" android:textSize="12sp"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card_outline" android:padding="12dp" android:layout_marginTop="12dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/CbText.Label" android:text="UPCOMING QUESTIONS" android:textColor="@color/cb_ink" android:textSize="10sp" android:layout_marginBottom="2dp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="12dp" android:paddingBottom="12dp">
                <TextView android:layout_width="22dp" android:layout_height="22dp" style="@style/CbText.Caption" android:text="2" android:gravity="center" android:background="@drawable/bg_tag_dark" android:textColor="@color/cb_bg" android:fontFamily="@font/nunito_extrabold"/>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" style="@style/CbText.Strong" android:text="Why did you choose a hash map?" android:layout_marginStart="12dp" android:layout_weight="1" android:textSize="12sp"/>
                <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_cb_lock" app:tint="@color/cb_text_secondary" android:importantForAccessibility="no"/>
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/cb_line"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="12dp" android:paddingBottom="12dp">
                <TextView android:layout_width="22dp" android:layout_height="22dp" style="@style/CbText.Caption" android:text="3" android:gravity="center" android:background="@drawable/bg_tag_dark" android:textColor="@color/cb_bg" android:fontFamily="@font/nunito_extrabold"/>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" style="@style/CbText.Strong" android:text="What is the time and space complexity?" android:layout_marginStart="12dp" android:layout_weight="1" android:textSize="12sp"/>
                <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_cb_lock" app:tint="@color/cb_text_secondary" android:importantForAccessibility="no"/>
            </LinearLayout>
        </LinearLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/btnSubmitAnswer" android:layout_width="match_parent" android:layout_height="44dp" style="@style/CbButton.Green" android:text="Submit recording &amp; next question →" android:layout_marginTop="14dp"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btnEnd" android:layout_width="match_parent" android:layout_height="50dp" style="@style/CbButton.Black" android:text="End interview &amp; view results →" android:layout_marginTop="8dp"/>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>