<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cb_bg"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <!-- Top Header -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="36dp">

            <TextView
                style="@style/CbText.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|center_vertical"
                android:text="Topics &amp; Practice"
                android:textSize="18sp" />
        </FrameLayout>

        <!-- Category Filter Chips -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:clipToPadding="false"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipAll"
                    style="@style/CbText.Strong"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_chip_selected"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="6dp"
                    android:text="All"
                    android:textColor="@color/cb_bg"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/chipTech"
                    style="@style/CbText.Strong"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_chip"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="6dp"
                    android:text="Tech"
                    android:textColor="@color/cb_ink"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/chipDsaFilter"
                    style="@style/CbText.Strong"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_chip"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="6dp"
                    android:text="DSA"
                    android:textColor="@color/cb_ink"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/chipSysDesign"
                    style="@style/CbText.Strong"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="6dp"
                    android:text="System Design"
                    android:textColor="@color/cb_ink"
                    android:textSize="11sp" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Section Title: Topics -->
        <TextView
            style="@style/CbText.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Topics"
            android:textSize="15sp" />

        <!-- 2-Column Topics Grid -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical">

            <!-- ROW 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <!-- Topic 1: DSA -->
                <LinearLayout
                    android:id="@+id/topicDsa"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_outline"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_tile"
                            android:backgroundTint="@color/cb_cat_sky"
                            android:gravity="center">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_cb_code"
                                app:tint="@color/cb_ink" />
                        </LinearLayout>

                        <TextView
                            style="@style/CbText.Strong"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:text="Data Structures &amp; Algorithms"
                            android:textSize="11sp" />

                        <ImageView
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_cb_up"
                            android:rotation="90"
                            app:tint="@color/cb_text_secondary" />
                    </LinearLayout>

                    <TextView
                        style="@style/CbText.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="0 / 12"
                        android:textSize="11sp" />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:indeterminate="false"
                        android:progress="0"
                        app:indicatorColor="@color/cb_green"
                        app:trackColor="@color/cb_line"
                        app:trackCornerRadius="2dp"
                        app:trackThickness="3dp" />
                </LinearLayout>

                <!-- Topic 2: Algorithms -->
                <LinearLayout
                    android:id="@+id/topicAlgo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_outline"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_tile"
                            android:backgroundTint="@color/cb_cat_sky"
                            android:gravity="center">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_cb_spark"
                                app:tint="@color/cb_ink" />
                        </LinearLayout>

                        <TextView
                            style="@style/CbText.Strong"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:text="Algorithms"
                            android:textSize="11sp" />

                        <ImageView
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_cb_up"
                            android:rotation="90"
                            app:tint="@color/cb_text_secondary" />
                    </LinearLayout>

                    <TextView
                        style="@style/CbText.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="0 / 10"
                        android:textSize="11sp" />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:indeterminate="false"
                        android:progress="0"
                        app:indicatorColor="@color/cb_green"
                        app:trackColor="@color/cb_line"
                        app:trackCornerRadius="2dp"
                        app:trackThickness="3dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- ROW 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <!-- Topic 3: Programming Concepts -->
                <LinearLayout
                    android:id="@+id/topicProg"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_outline"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_tile"
                            android:backgroundTint="@color/cb_cat_sky"
                            android:gravity="center">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_cb_code"
                                app:tint="@color/cb_ink" />
                        </LinearLayout>

                        <TextView
                            style="@style/CbText.Strong"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:text="Programming Concepts"
                            android:textSize="11sp" />

                        <ImageView
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_cb_up"
                            android:rotation="90"
                            app:tint="@color/cb_text_secondary" />
                    </LinearLayout>

                    <TextView
                        style="@style/CbText.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="0 / 8"
                        android:textSize="11sp" />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:indeterminate="false"
                        android:progress="0"
                        app:indicatorColor="@color/cb_green"
                        app:trackColor="@color/cb_line"
                        app:trackCornerRadius="2dp"
                        app:trackThickness="3dp" />
                </LinearLayout>

                <!-- Topic 4: Database Systems -->
                <LinearLayout
                    android:id="@+id/topicDb"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_outline"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_tile"
                            android:backgroundTint="@color/cb_cat_peach"
                            android:gravity="center">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_cb_chart"
                                app:tint="@color/cb_ink" />
                        </LinearLayout>

                        <TextView
                            style="@style/CbText.Strong"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:text="Database Systems"
                            android:textSize="11sp" />

                        <ImageView
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_cb_up"
                            android:rotation="90"
                            app:tint="@color/cb_text_secondary" />
                    </LinearLayout>

                    <TextView
                        style="@style/CbText.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="0 / 8"
                        android:textSize="11sp" />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:indeterminate="false"
                        android:progress="0"
                        app:indicatorColor="@color/cb_green"
                        app:trackColor="@color/cb_line"
                        app:trackCornerRadius="2dp"
                        app:trackThickness="3dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- ROW 3 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <!-- Topic 5: Web Development -->
                <LinearLayout
                    android:id="@+id/topicWeb"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_outline"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_tile"
                            android:backgroundTint="@color/cb_cat_sky"
                            android:gravity="center">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_cb_code"
                                app:tint="@color/cb_ink" />
                        </LinearLayout>

                        <TextView
                            style="@style/CbText.Strong"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:text="Web Development"
                            android:textSize="11sp" />

                        <ImageView
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_cb_up"
                            android:rotation="90"
                            app:tint="@color/cb_text_secondary" />
                    </LinearLayout>

                    <TextView
                        style="@style/CbText.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="0 / 10"
                        android:textSize="11sp" />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:indeterminate="false"
                        android:progress="0"
                        app:indicatorColor="@color/cb_green"
                        app:trackColor="@color/cb_line"
                        app:trackCornerRadius="2dp"
                        app:trackThickness="3dp" />
                </LinearLayout>

                <!-- Topic 6: Mobile Development -->
                <LinearLayout
                    android:id="@+id/topicMobile"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_outline"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_tile"
                            android:backgroundTint="@color/cb_cat_lilac"
                            android:gravity="center">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_cb_user"
                                app:tint="@color/cb_ink" />
                        </LinearLayout>

                        <TextView
                            style="@style/CbText.Strong"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:text="Mobile Development"
                            android:textSize="11sp" />

                        <ImageView
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_cb_up"
                            android:rotation="90"
                            app:tint="@color/cb_text_secondary" />
                    </LinearLayout>

                    <TextView
                        style="@style/CbText.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="0 / 8"
                        android:textSize="11sp" />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:indeterminate="false"
                        android:progress="0"
                        app:indicatorColor="@color/cb_green"
                        app:trackColor="@color/cb_line"
                        app:trackCornerRadius="2dp"
                        app:trackThickness="3dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- ROW 4 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <!-- Topic 7: Cloud Computing -->
                <LinearLayout
                    android:id="@+id/topicCloud"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_outline"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_tile"
                            android:backgroundTint="@color/cb_cat_sky"
                            android:gravity="center">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_cb_spark"
                                app:tint="@color/cb_ink" />
                        </LinearLayout>

                        <TextView
                            style="@style/CbText.Strong"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:text="Cloud Computing"
                            android:textSize="11sp" />

                        <ImageView
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_cb_up"
                            android:rotation="90"
                            app:tint="@color/cb_text_secondary" />
                    </LinearLayout>

                    <TextView
                        style="@style/CbText.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="0 / 8"
                        android:textSize="11sp" />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:indeterminate="false"
                        android:progress="0"
                        app:indicatorColor="@color/cb_green"
                        app:trackColor="@color/cb_line"
                        app:trackCornerRadius="2dp"
                        app:trackThickness="3dp" />
                </LinearLayout>

                <!-- Topic 8: Git & GitHub -->
                <LinearLayout
                    android:id="@+id/topicGit"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_outline"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_tile"
                            android:backgroundTint="@color/cb_tile_lime"
                            android:gravity="center">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_cb_branch"
                                app:tint="@color/cb_ink" />
                        </LinearLayout>

                        <TextView
                            style="@style/CbText.Strong"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:text="Git &amp; GitHub"
                            android:textSize="11sp" />

                        <ImageView
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_cb_up"
                            android:rotation="90"
                            app:tint="@color/cb_text_secondary" />
                    </LinearLayout>

                    <TextView
                        style="@style/CbText.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="0 / 6"
                        android:textSize="11sp" />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:indeterminate="false"
                        android:progress="0"
                        app:indicatorColor="@color/cb_green"
                        app:trackColor="@color/cb_line"
                        app:trackCornerRadius="2dp"
                        app:trackThickness="3dp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
