<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cb_bg"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <!-- Top Header -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="36dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back"
                android:src="@drawable/ic_cb_back" />

            <TextView
                style="@style/CbText.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Explore CodeBridge"
                android:textSize="17sp" />
        </FrameLayout>

        <!-- Search Bar -->
        <EditText
            android:id="@+id/etSearch"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:drawableStart="@drawable/ic_cb_search"
            android:drawablePadding="8dp"
            android:drawableTint="@color/cb_text_secondary"
            android:fontFamily="@font/nunito_regular"
            android:hint="Search challenges, company briefs, events…"
            android:imeOptions="actionSearch"
            android:importantForAutofill="no"
            android:inputType="text"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textSize="12sp" />

        <!-- Category Section 1: Technical Challenges -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/CbText.Section"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Technical Challenges"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/linkTech"
                style="@style/CbText.Link"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="View all →"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card"
            android:backgroundTint="@color/cb_cat_lilac"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                style="@style/CbText.Strong"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Data Structures &amp; Algorithms"
                android:textSize="13sp" />

            <TextView
                style="@style/CbText.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="52 algorithmic problems categorized by difficulty."
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Category Section 2: Company Briefs -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/CbText.Section"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Company Challenges &amp; Briefs"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/linkCompany"
                style="@style/CbText.Link"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="View briefs →"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card"
            android:backgroundTint="@color/cb_cat_peach"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                style="@style/CbText.Strong"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fintech Payment Gateway Brief · Capitec"
                android:textSize="13sp" />

            <TextView
                style="@style/CbText.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Build a resilient transaction processing pipeline."
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Category Section 3: Events & Hackathons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/CbText.Section"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Events &amp; Hackathons"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/linkEvents"
                style="@style/CbText.Link"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="See events →"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card"
            android:backgroundTint="@color/cb_cat_sky"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                style="@style/CbText.Strong"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Developer Hackathon 2026 · Johannesburg"
                android:textSize="13sp" />

            <TextView
                style="@style/CbText.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Join top SA tech companies for a 48-hour build."
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
