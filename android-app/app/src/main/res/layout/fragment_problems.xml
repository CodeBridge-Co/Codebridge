<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cb_bg"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <!-- Top Header -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="48dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_cb_back" />

            <TextView
                android:id="@+id/tvHeaderTitle"
                style="@style/CbText.Strong"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Two Sum · Easy"
                android:textSize="15sp" />
        </FrameLayout>

        <!-- Stepper -->
        <za.co.eduvos.codebridge.ui.StepperView
            android:id="@+id/stepper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <!-- Tabs -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_chip"
            android:orientation="horizontal"
            android:padding="3dp">

            <TextView
                android:id="@+id/tabProblem"
                style="@style/CbText.Strong"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Problem"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tabExamples"
                style="@style/CbText.Strong"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Examples"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tabConstraints"
                style="@style/CbText.Strong"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Constraints"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Problem Description Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/tvTitle"
                style="@style/CbText.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Two Sum"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvDesc"
                style="@style/CbText.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Given an array of integers and a target, return indices of the two numbers that add up to the target."
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvExampleLabel"
                style="@style/CbText.Strong"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Example 1:\nnums = [2,7,11,15], target = 9\noutput = [0,1]"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvExample"
                style="@style/CbText.Mono"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Solution Editor Card -->
        <LinearLayout
            android:id="@+id/cardSolutionEditor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_dark_card"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- Toolbar Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvLanguageSelector"
                    style="@style/CbText.Caption"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:text="Solution · JavaScript ∨"
                    android:textColor="@color/cb_bg"
                    android:textSize="12sp" />

                <!-- Toolbar Icons: Reset / Format / Copy -->
                <ImageButton
                    android:id="@+id/btnReset"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Reset Template"
                    android:padding="12dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_cb_spark"
                    app:tint="@color/cb_bg" />

                <ImageButton
                    android:id="@+id/btnFormat"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Format Code"
                    android:padding="12dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_cb_brace"
                    app:tint="@color/cb_bg" />

                <ImageButton
                    android:id="@+id/btnCopy"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Copy Code"
                    android:padding="12dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_cb_copy"
                    app:tint="@color/cb_bg" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/cb_white_20" />

            <!-- Code Editor Area -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <EditText
                    android:id="@+id/etCode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:fontFamily="monospace"
                    android:gravity="top"
                    android:importantForAutofill="no"
                    android:inputType="textMultiLine|textNoSuggestions"
                    android:minLines="6"
                    android:paddingTop="10dp"
                    android:paddingEnd="36dp"
                    android:text="class Solution {\n    public int[] twoSum(int[] nums, int target) {\n        // Write your solution here\n    }\n}"
                    android:textColor="@color/cb_green_light"
                    android:textSize="12sp" />

                <ImageButton
                    android:id="@+id/btnExpand"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="bottom|end"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Expand Editor"
                    android:padding="12dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_cb_max"
                    app:tint="@color/cb_bg" />
            </FrameLayout>
        </LinearLayout>

        <!-- Testcases Section Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/CbText.Caption"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Testcases"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvPassed"
                style="@style/CbText.Link"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:text="Passed 0/3"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRun"
                style="@style/CbButton.Green.Small"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:paddingHorizontal="16dp"
                android:text="Run tests"
                android:textSize="12sp"
                app:cornerRadius="24dp"
                app:icon="@drawable/ic_cb_play"
                app:iconSize="14dp"
                app:iconTint="@color/cb_ink" />
        </LinearLayout>

        <!-- Testcases Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_card_outline"
            android:orientation="vertical"
            android:paddingHorizontal="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/CbText.Caption"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:background="@drawable/bg_circle_grey"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="@color/cb_ink"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/tvCase1"
                    style="@style/CbText.Mono"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="nums = [2,7,11,15]"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvCaseStatus1"
                    style="@style/CbText.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ready"
                    android:textSize="10sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/cb_line" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/CbText.Caption"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:background="@drawable/bg_circle_grey"
                    android:gravity="center"
                    android:text="2"
                    android:textColor="@color/cb_ink"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/tvCase2"
                    style="@style/CbText.Mono"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="nums = [3,2,4]"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvCaseStatus2"
                    style="@style/CbText.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ready"
                    android:textSize="10sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/cb_line" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/CbText.Caption"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:background="@drawable/bg_circle_grey"
                    android:gravity="center"
                    android:text="3"
                    android:textColor="@color/cb_ink"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/tvCase3"
                    style="@style/CbText.Mono"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="nums = [3,3]"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvCaseStatus3"
                    style="@style/CbText.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ready"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Main Action Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSubmit"
            style="@style/CbButton.Black"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:text="Submit code &amp; advance to Git stage →"
            android:textSize="13sp" />

        <!-- AI Assistance Banner (Matching Wireframe Screenshot) -->
        <LinearLayout
            android:id="@+id/cardAiBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_ai_hint"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_circle_grey"
                android:backgroundTint="#EFF7E6"
                android:gravity="center">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_cb_spark"
                    app:tint="@color/cb_green_dark" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvAiBannerTitle"
                    style="@style/CbText.Strong"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Slide right for AI assistance (3 attempts left)"
                    android:textColor="@color/cb_ink"
                    android:textSize="12sp" />

                <TextView
                    style="@style/CbText.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="Get hints, explanations, and more"
                    android:textColor="@color/cb_text_secondary"
                    android:textSize="10sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnAiSlide"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_circle_black"
                android:fontFamily="@font/nunito_extrabold"
                android:gravity="center"
                android:text="→"
                android:textColor="@color/cb_bg"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
