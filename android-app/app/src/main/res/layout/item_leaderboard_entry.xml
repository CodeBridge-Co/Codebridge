<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_card_outline"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <!-- Rank Badge -->
    <TextView
        android:id="@+id/tvRank"
        style="@style/CbText.Strong"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:background="@drawable/bg_circle_grey"
        android:gravity="center"
        android:text="1"
        android:textColor="@color/cb_ink"
        android:textSize="12sp" />

    <!-- Avatar / Mascot Icon -->
    <ImageView
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="10dp"
        android:importantForAccessibility="no"
        android:src="@drawable/code_launcher" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvHashId"
            style="@style/CbText.Strong"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="Hash: 7F3A9C2B"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvLevelPoints"
            style="@style/CbText.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Level 12  ·  980 pts"
            android:textColor="@color/cb_text_secondary"
            android:textSize="10sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvStreak"
        style="@style/CbText.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔥 12d"
        android:textColor="#E65100"
        android:textSize="11sp" />
</LinearLayout>
