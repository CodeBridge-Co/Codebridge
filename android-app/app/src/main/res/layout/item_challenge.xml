<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_card_outline"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <!-- Tile Icon -->
    <LinearLayout
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_tile"
        android:backgroundTint="@color/cb_cat_lilac"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/ivStatus"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_cb_code"
            app:tint="@color/cb_green_dark" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTitle"
            style="@style/CbText.Strong"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Two Sum"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvCategory"
                style="@style/CbText.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tag_dark"
                android:backgroundTint="@color/cb_cat_sky"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="Arrays"
                android:textColor="@color/cb_ink"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tvDifficulty"
                style="@style/CbText.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_tag_dark"
                android:backgroundTint="@color/cb_green_tint"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="Easy"
                android:textColor="@color/cb_green_dark"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvAcceptance"
            style="@style/CbText.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Total Attempts: 0  ·  Success Rate: 0%"
            android:textColor="@color/cb_text_secondary"
            android:textSize="10sp" />
    </LinearLayout>

    <ImageView
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginStart="8dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_cb_up"
        android:rotation="90"
        app:tint="@color/cb_text_secondary" />
</LinearLayout>
