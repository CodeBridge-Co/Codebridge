<resources>
    <style name="CbText">
        <item name="android:fontFamily">@font/nunito_regular</item>
        <item name="android:textColor">@color/cb_ink</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="CbText.Hero">
        <item name="android:textSize">22sp</item>
        <item name="android:fontFamily">@font/nunito_extrabold</item>
    </style>
    <style name="CbText.Title">
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">@font/nunito_extrabold</item>
    </style>
    <style name="CbText.Section">
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">@font/nunito_extrabold</item>
    </style>
    <style name="CbText.Strong">
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">@font/nunito_bold</item>
    </style>
    <style name="CbText.Body">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/cb_text_secondary</item>
    </style>
    <style name="CbText.Caption">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/cb_text_secondary</item>
    </style>
    <style name="CbText.Label">
        <item name="android:textSize">10sp</item>
        <item name="android:fontFamily">@font/nunito_extrabold</item>
        <item name="android:textColor">@color/cb_green_dark</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
    </style>
    <style name="CbText.Mono">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">11sp</item>
    </style>
    <style name="CbText.Link">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">@font/nunito_bold</item>
        <item name="android:textColor">@color/cb_green_dark</item>
    </style>
    <style name="CbButton" parent="Widget.Material3.Button">
        <item name="android:fontFamily">@font/nunito_extrabold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="cornerRadius">24dp</item>
    </style>
    <style name="CbButton.Black">
        <item name="backgroundTint">@color/cb_ink</item>
        <item name="android:textColor">@color/cb_bg</item>
    </style>
    <style name="CbButton.Green">
        <item name="backgroundTint">@color/cb_green</item>
        <item name="android:textColor">@color/cb_ink</item>
    </style>
    <style name="CbButton.White">
        <item name="backgroundTint">@color/cb_bg</item>
        <item name="android:textColor">@color/cb_ink</item>
    </style>
    <style name="CbButton.Small">
        <item name="android:minHeight">36dp</item>
        <item name="android:textSize">12sp</item>
        <item name="cornerRadius">18dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
    </style>
    <style name="CbButton.Outline" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:fontFamily">@font/nunito_bold</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/cb_ink</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">36dp</item>
        <item name="strokeColor">@color/cb_line</item>
        <item name="cornerRadius">18dp</item>
    </style>
    <style name="CbButton.Green.Small">
        <item name="android:minHeight">36dp</item>
        <item name="android:textSize">12sp</item>
        <item name="cornerRadius">18dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
    </style>
    <style name="CbButton.White.Small">
        <item name="android:minHeight">30dp</item>
        <item name="android:textSize">11sp</item>
        <item name="cornerRadius">15dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
    </style>
</resources>