<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="cb_bg">#FFFFFF</color>
    <color name="cb_bg_top">#F4FBEA</color>
    <color name="cb_card">#F2F4EE</color>
    <color name="cb_cat_lilac">#E7E0FB</color>
    <color name="cb_cat_peach">#FFE3D0</color>
    <color name="cb_cat_sky">#DDEBF7</color>
    <color name="cb_dark_green">#124226</color>
    <color name="cb_green">#6EC20F</color>
    <color name="cb_green_dark">#3D9A00</color>
    <color name="cb_green_light">#A6E34A</color>
    <color name="cb_green_line">#CBEAA8</color>
    <color name="cb_green_tint">#EAF7DC</color>
    <color name="cb_ink">#121212</color>
    <color name="cb_ink2">#1E1E1E</color>
    <color name="cb_line">#E4E7DF</color>
    <color name="cb_red">#FF4B4B</color>
    <color name="cb_stroke">#DDE5DA</color>
    <color name="cb_stroke_soft">#66A3B3A0</color>
    <color name="cb_text_secondary">#5F6B63</color>
    <color name="cb_tile_lime">#B8EB6A</color>
    <color name="cb_tile_mint">#A9E6CF</color>
    <color name="cb_tile_peach">#FDBA7B</color>
    <color name="cb_tile_sky">#9CCBEE</color>
    <color name="cb_white_10">#1AFFFFFF</color>
    <color name="cb_white_20">#33FFFFFF</color>
    <color name="code_launcher_background">#FFFFFF</color>
    <color name="purple_500">#6200EE</color>
    <color name="white">#FFFFFFFF</color>
    <string name="app_name">CodeBridge</string>
    <string name="brand_name_html"><![CDATA[<font color="#124226">Code</font><font color="#6EC20F">Bridge</font>]]></string>
    <string name="cd_brand_icon">Brand icon</string>
    <string name="cd_mascot">CodeBridge mascot</string>
    <string name="help_question_mark">\?</string>
    <string name="splash_tagline">Build your skills.\nBridge your future.</string>
    <style name="CbButton" parent="Widget.Material3.Button">
        <item name="android:fontFamily">@font/nunito_extrabold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="cornerRadius">24dp</item>
    </style>
    <style name="CbButton.Black">
        <item name="backgroundTint">@color/cb_ink</item>
        <item name="android:textColor">@color/cb_bg</item>
    </style>
    <style name="CbButton.Green">
        <item name="backgroundTint">@color/cb_green</item>
        <item name="android:textColor">@color/cb_ink</item>
    </style>
    <style name="CbButton.Green.Small">
        <item name="android:minHeight">36dp</item>
        <item name="android:textSize">12sp</item>
        <item name="cornerRadius">18dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
    </style>
    <style name="CbButton.Outline" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:fontFamily">@font/nunito_bold</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/cb_ink</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">36dp</item>
        <item name="strokeColor">@color/cb_line</item>
        <item name="cornerRadius">18dp</item>
    </style>
    <style name="CbButton.Small">
        <item name="android:minHeight">36dp</item>
        <item name="android:textSize">12sp</item>
        <item name="cornerRadius">18dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
    </style>
    <style name="CbButton.White">
        <item name="backgroundTint">@color/cb_bg</item>
        <item name="android:textColor">@color/cb_ink</item>
    </style>
    <style name="CbButton.White.Small">
        <item name="android:minHeight">30dp</item>
        <item name="android:textSize">11sp</item>
        <item name="cornerRadius">15dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
    </style>
    <style name="CbText">
        <item name="android:fontFamily">@font/nunito_regular</item>
        <item name="android:textColor">@color/cb_ink</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="CbText.Body">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/cb_text_secondary</item>
    </style>
    <style name="CbText.Caption">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/cb_text_secondary</item>
    </style>
    <style name="CbText.Hero">
        <item name="android:textSize">22sp</item>
        <item name="android:fontFamily">@font/nunito_extrabold</item>
    </style>
    <style name="CbText.Label">
        <item name="android:textSize">10sp</item>
        <item name="android:fontFamily">@font/nunito_extrabold</item>
        <item name="android:textColor">@color/cb_green_dark</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
    </style>
    <style name="CbText.Link">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">@font/nunito_bold</item>
        <item name="android:textColor">@color/cb_green_dark</item>
    </style>
    <style name="CbText.Mono">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">11sp</item>
    </style>
    <style name="CbText.Section">
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">@font/nunito_extrabold</item>
    </style>
    <style name="CbText.Strong">
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">@font/nunito_bold</item>
    </style>
    <style name="CbText.Title">
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">@font/nunito_extrabold</item>
    </style>
    <style name="Theme.CodeBridge" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/cb_green</item>
        <item name="colorOnPrimary">@color/cb_ink</item>
        <item name="android:statusBarColor">@color/cb_bg</item>
        <item name="android:navigationBarColor">@color/cb_bg</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <style name="Theme.CodeBridge.Splash" parent="Theme.CodeBridge">
        <item name="android:windowBackground">@drawable/bg_splash</item>
    </style>
</resources>